@using BanHangDienTu.Models.Enums
@model BanHangDienTu.ViewModels.Product.ProductListViewModel

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h2 mb-1">Danh sách sản phẩm</h1>

        <p class="text-muted mb-0">
            Tìm kiếm và lựa chọn sản phẩm phù hợp với bạn.
        </p>
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-lg-5">

                        <label for="searchTerm"
                               class="form-label">
                            Tìm kiếm
                        </label>

                        <input type="search"
                               id="searchTerm"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               maxlength="100"
                               class="form-control"
                               placeholder="Tên sản phẩm hoặc danh mục..." />

                    </div>

                    <div class="col-12 col-md-6 col-lg-3">

                        <label for="categoryId"
                               class="form-label">
                            Danh mục
                        </label>

                        <select id="categoryId"
                                name="categoryId"
                                class="form-select">

                            <option value="">
                                Tất cả danh mục
                            </option>

                            @foreach (var category in Model.Categories)
                            {
                                if (Model.CategoryId == category.Id)
                                {
                                    <option value="@category.Id" selected>
                                        @category.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-12 col-md-6 col-lg-2">

                        <label for="sort"
                               class="form-label">
                            Sắp xếp
                        </label>

                        <select id="sort"
                                name="sort"
                                class="form-select">

                            @if (Model.Sort == ProductSortOption.Newest)
                            {
                                <option value="@ProductSortOption.Newest" selected>
                                    Mới nhất
                                </option>
                            }
                            else
                            {
                                <option value="@ProductSortOption.Newest">
                                    Mới nhất
                                </option>
                            }

                            @if (Model.Sort == ProductSortOption.PriceAscending)
                            {
                                <option value="@ProductSortOption.PriceAscending" selected>
                                    Giá tăng dần
                                </option>
                            }
                            else
                            {
                                <option value="@ProductSortOption.PriceAscending">
                                    Giá tăng dần
                                </option>
                            }

                            @if (Model.Sort == ProductSortOption.PriceDescending)
                            {
                                <option value="@ProductSortOption.PriceDescending" selected>
                                    Giá giảm dần
                                </option>
                            }
                            else
                            {
                                <option value="@ProductSortOption.PriceDescending">
                                    Giá giảm dần
                                </option>
                            }

                            @if (Model.Sort == ProductSortOption.NameAscending)
                            {
                                <option value="@ProductSortOption.NameAscending" selected>
                                    Tên A → Z
                                </option>
                            }
                            else
                            {
                                <option value="@ProductSortOption.NameAscending">
                                    Tên A → Z
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-12 col-lg-2">

                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Lọc sản phẩm
                            </button>

                            <a asp-controller="Product"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Đặt lại
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <strong>@Model.TotalItems</strong>
            sản phẩm
        </div>

        @if (Model.TotalPages > 0)
        {
            <div class="text-muted">
                Trang @Model.CurrentPage / @Model.TotalPages
            </div>
        }

    </div>

    @if (Model.Products.Count == 0)
    {
        <div class="alert alert-warning">
            Không tìm thấy sản phẩm phù hợp.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var product in Model.Products)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                    <div class="card product-card h-100 shadow-sm">

                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="text-decoration-none">

                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     class="card-img-top product-image"
                                     alt="@product.Name" />
                            }
                            else
                            {
                                <div class="product-image-placeholder">
                                    <span>Chưa có ảnh</span>
                                </div>
                            }

                        </a>

                        <div class="card-body d-flex flex-column">

                            <span class="badge text-bg-light align-self-start mb-2">
                                @product.CategoryName
                            </span>

                            <h2 class="h6 product-name">

                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">
                                    @product.Name
                                </a>

                            </h2>

                            <div class="mt-auto">

                                <div class="fw-bold text-danger fs-5 mb-2">
                                    @product.Price.ToString("N0") ₫
                                </div>

                                @if (product.StockQuantity > 0)
                                {
                                    <span class="text-success">
                                        Còn hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger">
                                        Hết hàng
                                    </span>
                                }

                                <div class="d-grid mt-3">

                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-outline-primary">
                                        Xem chi tiết
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-5"
             aria-label="Phân trang sản phẩm">

            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                    @if (Model.HasPreviousPage)
                    {
                        <a class="page-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-sort="@Model.Sort"
                           asp-route-page="@(Model.CurrentPage - 1)">
                            Trước
                        </a>
                    }
                    else
                    {
                        <span class="page-link">
                            Trước
                        </span>
                    }

                </li>

                @for (var pageNumber = 1;
                     pageNumber <= Model.TotalPages;
                     pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">

                        <a class="page-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-sort="@Model.Sort"
                           asp-route-page="@pageNumber">

                            @pageNumber

                        </a>

                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                    @if (Model.HasNextPage)
                    {
                        <a class="page-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-sort="@Model.Sort"
                           asp-route-page="@(Model.CurrentPage + 1)">
                            Sau
                        </a>
                    }
                    else
                    {
                        <span class="page-link">
                            Sau
                        </span>
                    }

                </li>

            </ul>

        </nav>
    }

</div>