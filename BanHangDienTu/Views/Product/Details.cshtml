@model BanHangDienTu.ViewModels.Product.ProductDetailViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["SuccessMessage"]
            <a asp-controller="Cart" asp-action="Index" class="alert-link ms-2">Xem giỏ hàng ngay &rarr;</a>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-4">
        <a asp-controller="Product"
           asp-action="Index"
           class="text-decoration-none">
            ← Quay lại danh sách sản phẩm
        </a>
    </div>

    <div class="row g-5">

        <div class="col-12 col-lg-6">

            <div class="border rounded bg-white p-4 text-center">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="img-fluid"
                         style="max-height: 450px; object-fit: contain;"
                         onerror="this.onerror=null; this.src='/images/default-product.svg';" />
                }
                else
                {
                    <div class="product-image-placeholder rounded"
                         style="height: 400px;">
                        <span>Chưa có ảnh sản phẩm</span>
                    </div>
                }

            </div>

        </div>

        <div class="col-12 col-lg-6">

            <div class="mb-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-categoryId="@Model.CategoryId"
                   class="badge text-bg-light text-decoration-none">
                    @Model.CategoryName
                </a>

            </div>

            <h1 class="h2 mb-3">
                @Model.Name
            </h1>

            <div class="fs-3 fw-bold text-danger mb-4">
                @Model.Price.ToString("N0") ₫
            </div>

            <div class="mb-4">

                @if (Model.InStock)
                {
                    <div class="alert alert-success mb-0">
                        Còn hàng - @Model.StockQuantity sản phẩm có sẵn
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mb-0">
                        Sản phẩm hiện đang hết hàng
                    </div>
                }

            </div>

            <div class="mb-4">

                <h2 class="h5">
                    Mô tả sản phẩm
                </h2>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted">
                        @Model.Description
                    </p>
                }
                else
                {
                    <p class="text-muted">
                        Chưa có mô tả cho sản phẩm này.
                    </p>
                }

            </div>

            @if (Model.InStock)
            {
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="d-flex align-items-center mb-4">
                        <label class="me-3 fw-semibold">Số lượng:</label>
                        <div class="input-group" style="width: 140px;">
                            <input type="number"
                                   name="quantity"
                                   class="form-control text-center"
                                   value="1"
                                   min="1"
                                   max="@Model.StockQuantity"
                                   required />
                        </div>
                        <span class="text-muted small ms-3">(Tối đa: @Model.StockQuantity)</span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex">

                        <button type="submit"
                                name="returnUrl"
                                value="@Context.Request.Path"
                                class="btn btn-primary btn-lg">
                            Thêm vào giỏ hàng
                        </button>

                        <button type="submit"
                                formaction="@Url.Action("BuyNow", "Cart")"
                                class="btn btn-outline-danger btn-lg">
                            Mua ngay
                        </button>

                    </div>
                </form>
            }
            else
            {
                <div class="d-grid gap-2 d-md-flex">
                    <button type="button" class="btn btn-secondary btn-lg" disabled>
                        Hết hàng
                    </button>
                </div>
            }

        </div>

    </div>

</div>