@model BanHangDienTu.ViewModels.Account.ProfileViewModel

@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-8">

            <div class="mb-4">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="text-decoration-none">
                    ← Quay lại hồ sơ
                </a>

            </div>

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">

                        <h1 class="h3 mb-2">
                            Chỉnh sửa thông tin
                        </h1>

                        <p class="text-muted mb-0">
                            Cập nhật thông tin cá nhân và địa chỉ giao hàng của bạn.
                        </p>

                    </div>

                    <form asp-controller="Profile"
                          asp-action="Edit"
                          method="post"
                          id="profileEditForm">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="FullName"
                                   class="form-label">
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   autocomplete="name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />

                            <div class="form-text">
                                Email dùng để đăng nhập và hiện không thể thay đổi.
                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   autocomplete="tel"
                                   placeholder="Ví dụ: 0901234567" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Address"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500"
                                      autocomplete="street-address"
                                      placeholder="Nhập địa chỉ nhận hàng đầy đủ"></textarea>

                            <span asp-validation-for="Address"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Địa chỉ này sẽ được dùng làm địa chỉ giao hàng mặc định.
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Hủy
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Lưu thay đổi
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            $("#profileEditForm input:not([readonly]), #profileEditForm textarea")
                .on("input blur", function () {
                    $(this).valid();
                });

        });
    </script>
}