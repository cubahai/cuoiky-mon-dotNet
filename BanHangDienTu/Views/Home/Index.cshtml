@model BanHangDienTu.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

<section class="home-hero mb-5">
    <div class="container py-5 text-center">
        <h1 class="display-5 fw-bold mb-3">
            Cửa hàng công nghệ
        </h1>

        <p class="lead text-muted mb-4">
            Khám phá các sản phẩm công nghệ mới nhất với mức giá phù hợp.
        </p>

        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <form asp-controller="Home"
                      asp-action="Index"
                      method="get">

                    <div class="input-group input-group-lg">
                        <input type="search"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               maxlength="100"
                               placeholder="Tìm kiếm sản phẩm..."
                               aria-label="Tìm kiếm sản phẩm" />

                        <button class="btn btn-primary"
                                type="submit">
                            Tìm kiếm
                        </button>
                    </div>

                    <span asp-validation-for="SearchTerm"
                          class="text-danger d-block mt-2">
                    </span>
                </form>
            </div>
        </div>
    </div>
</section>

@if (Model.HasSearch)
{
    <section class="mb-5">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h3 mb-1">
                    Kết quả tìm kiếm
                </h2>

                <p class="text-muted mb-0">
                    Từ khóa:
                    <strong>@Model.SearchTerm</strong>
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Xóa tìm kiếm
            </a>
        </div>

        @if (Model.SearchResults.Count == 0)
        {
            <div class="alert alert-warning">
                Không tìm thấy sản phẩm phù hợp.
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var product in Model.SearchResults)
                {
                    <div class="col-12 col-sm-6 col-lg-3">

                        <div class="card product-card h-100 shadow-sm">

                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     class="card-img-top product-image"
                                     alt="@product.Name" />
                            }
                            else
                            {
                                <div class="product-image-placeholder">
                                    <span>Chưa có ảnh</span>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">

                                <span class="badge text-bg-light align-self-start mb-2">
                                    @product.CategoryName
                                </span>

                                <h3 class="h6 product-name">
                                    @product.Name
                                </h3>

                                <div class="mt-auto">

                                    <div class="fw-bold text-danger fs-5 mb-2">
                                        @product.Price.ToString("N0") ₫
                                    </div>

                                    @if (product.StockQuantity > 0)
                                    {
                                        <small class="text-success">
                                            Còn hàng
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-danger">
                                            Hết hàng
                                        </small>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </section>
}

<section class="mb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="h3 mb-0">
            Danh mục sản phẩm
        </h2>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-primary">
            Xem tất cả sản phẩm
        </a>

    </div>

    @if (Model.Categories.Count == 0)
    {
        <div class="alert alert-light border">
            Hiện chưa có danh mục sản phẩm.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var category in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-3">

                    <a asp-controller="Product"
                       asp-action="Index"
                       asp-route-categoryId="@category.Id"
                       class="text-decoration-none text-dark">

                        <div class="card category-card h-100 shadow-sm">

                            <div class="card-body text-center">

                                <div class="category-icon mb-3">
                                    @category.Name.Substring(0, 1).ToUpperInvariant()
                                </div>

                                <h3 class="h6 mb-0">
                                    @category.Name
                                </h3>

                            </div>

                        </div>

                    </a>

                </div>
            }

        </div>
    }

</section>

