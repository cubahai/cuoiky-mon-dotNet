@model BanHangDienTu.Models.OrderHistoryViewModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 text-center p-4 mb-4">
                <div class="mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle" style="width: 70px; height: 70px; font-size: 32px;">
                        ✓
                    </span>
                </div>
                <h2 class="text-success fw-bold">Đặt hàng thành công!</h2>
                <p class="text-muted">Cảm ơn bạn đã mua hàng tại BanHangDienTu. Đơn hàng của bạn đã được tiếp nhận và đang chờ xử lý.</p>
                
                <div class="bg-light p-3 rounded text-start mx-auto w-100 mt-2 mb-3">
                    <div class="row gy-2">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Mã đơn hàng:</span>
                            <span class="fw-bold fs-5 text-primary">#@Model.OrderId</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Thời gian đặt:</span>
                            <span class="fw-semibold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Người nhận:</span>
                            <span class="fw-semibold">@Model.CustomerName (@Model.PhoneNumber)</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Phương thức thanh toán:</span>
                            <span class="badge bg-secondary">@Model.PaymentMethod</span>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small d-block">Địa chỉ nhận hàng:</span>
                            <span>@Model.ShippingAddress</span>
                        </div>
                    </div>
                </div>

                <div class="text-start mt-2">
                    <h5 class="fw-bold mb-3">Chi tiết đơn hàng</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light small">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-end" style="width: 120px;">Đơn giá</th>
                                    <th class="text-center" style="width: 80px;">Số lượng</th>
                                    <th class="text-end" style="width: 130px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/default-product.svg" : item.ImageUrl)" alt="@item.ProductName" class="img-thumbnail me-2" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/default-product.svg';" />
                                                <span class="fw-semibold small">@item.ProductName</span>
                                            </div>
                                        </td>
                                        <td class="text-end small">@item.Price.ToString("N0") đ</td>
                                        <td class="text-center small">@item.Quantity</td>
                                        <td class="text-end text-danger fw-bold small">@item.TotalPrice.ToString("N0") đ</td>
                                    </tr>
                                }
                                <tr class="table-light">
                                    <td colspan="3" class="text-end fw-bold">Tổng thanh toán:</td>
                                    <td class="text-end text-danger fw-bold fs-6">@Model.TotalAmount.ToString("N0") đ</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">
                    <a asp-controller="OrderHistory" asp-action="Index" class="btn btn-outline-primary">
                        Xem lịch sử mua hàng
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-danger">
                        Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
