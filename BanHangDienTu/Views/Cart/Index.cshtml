@model List<BanHangDienTu.Models.CartItemViewModel>
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    var grandTotal = Model?.Sum(x => x.TotalPrice) ?? 0;
}

<div class="container mt-4">
    <h2 class="mb-4">Giỏ hàng của bạn</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Giỏ hàng của bạn đang trống. <a asp-controller="Home" asp-action="Index">Mua sắm ngay!</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th class="text-end" style="width: 150px;">Đơn giá</th>
                        <th class="text-center" style="width: 140px;">Số lượng</th>
                        <th class="text-end" style="width: 160px;">Thành tiền</th>
                        <th class="text-center" style="width: 100px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/default-product.svg" : item.ImageUrl)" alt="@item.ProductName" class="img-thumbnail" style="max-height: 70px; width: 70px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/default-product.svg';" />
                            </td>
                            <td>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark fw-semibold">
                                    @item.ProductName
                                </a>
                            </td>
                            <td class="text-end">
                                @item.Price.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                <form asp-action="UpdateQuantity" method="post" class="d-inline-flex align-items-center justify-content-center">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-sm btn-outline-secondary px-2 py-0" title="Giảm số lượng">-</button>
                                    <span class="mx-2 fw-semibold" style="min-width: 24px; text-align: center;">@item.Quantity</span>
                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-sm btn-outline-secondary px-2 py-0" title="Tăng số lượng">+</button>
                                </form>
                            </td>
                            <td class="text-end text-danger fw-bold">
                                @item.TotalPrice.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                <form asp-action="RemoveItem" method="post" class="d-inline" onsubmit="return confirm('Bạn có muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row justify-content-between align-items-center mt-3">
            <div class="col-auto">
                <form asp-action="Clear" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?');">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        Xóa toàn bộ giỏ hàng
                    </button>
                </form>
            </div>
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Tóm tắt đơn hàng</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span class="fw-bold">@grandTotal.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success fw-bold">Miễn phí</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3 fs-5">
                            <strong>Tổng thanh toán:</strong>
                            <strong class="text-danger">@grandTotal.ToString("N0") đ</strong>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-action="Checkout" class="btn btn-danger btn-lg text-center text-decoration-none">
                                Tiến hành Đặt hàng
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary text-center text-decoration-none">
                                Tiếp tục mua sắm
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
