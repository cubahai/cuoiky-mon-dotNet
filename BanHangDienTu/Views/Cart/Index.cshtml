@model BanHangDienTu.ViewModels.Cart.CartViewModel
@{ ViewData["Title"] = "Giỏ hàng"; }

<div class="py-4">
    <h1 class="h2 mb-4">Giỏ hàng của bạn</h1>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info">Giỏ hàng đang trống. <a asp-controller="Product" asp-action="Index">Khám phá sản phẩm</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th>Thao tác</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            { <img src="@item.ImageUrl" alt="" width="64" height="64" class="object-fit-contain me-2" /> }
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a>
                            @if (!item.CanOrder)
                            { <div class="text-danger small">@(item.IsActive ? $"Chỉ còn {item.StockQuantity} sản phẩm. Hãy cập nhật số lượng hoặc xóa." : "Sản phẩm đã ngừng bán. Vui lòng xóa khỏi giỏ.")</div> }
                        </td>
                        <td class="text-nowrap">@item.Price.ToString("N0") ₫</td>
                        <td>
                            <form asp-action="Update" method="post" class="d-flex gap-2">
                                <input type="hidden" name="ProductId" value="@item.ProductId" />
                                <input type="number" name="Quantity" value="@item.Quantity" min="1" max="999" required class="form-control" style="width:90px" aria-label="Số lượng @item.ProductName" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">Cập nhật</button>
                            </form>
                        </td>
                        <td class="text-nowrap fw-semibold">@item.TotalPrice.ToString("N0") ₫</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Xóa @item.ProductName">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card ms-auto mt-4" style="max-width:420px">
            <div class="card-body">
                <h2 class="h5">Tóm tắt đơn hàng</h2>
                <p>Phí vận chuyển: <span class="text-success">Miễn phí</span></p>
                <p class="fs-5">Tổng tiền: <strong class="text-danger">@Model.TotalAmount.ToString("N0") ₫</strong></p>
                @if (Model.CanCheckout)
                { <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary w-100">Tiến hành đặt hàng</a> }
                else
                { <p class="text-danger">Vui lòng cập nhật các sản phẩm không hợp lệ trước khi đặt hàng.</p> }
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Tiếp tục mua sắm</a>
            </div>
        </div>
    }
</div>
