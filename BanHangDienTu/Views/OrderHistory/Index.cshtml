@model BanHangDienTu.ViewModels.Order.OrderHistoryViewModel
@{ ViewData["Title"] = "Lịch sử đặt hàng"; }

<div class="py-4">
    <h1 class="h2 mb-4">Lịch sử đặt hàng</h1>
    @if (Model.Orders.Count == 0)
    { <div class="alert alert-info">Bạn chưa có đơn hàng nào. <a asp-controller="Product" asp-action="Index">Mua sắm ngay</a></div> }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Mã đơn</th><th>Ngày đặt (giờ Việt Nam)</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thanh toán</th><th></th></tr></thead>
                <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td class="text-break">@order.OrderNumber</td>
                        <td class="text-nowrap">@order.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-nowrap">@order.TotalAmount.ToString("N0") ₫</td>
                        <td>@order.StatusText</td><td>@order.PaymentStatusText</td>
                        <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary text-nowrap">Chi tiết</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang đơn hàng" class="d-flex justify-content-center align-items-center gap-3 mt-4">
                @if (Model.CurrentPage > 1) { <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" class="btn btn-outline-secondary">Trước</a> }
                <span>Trang @Model.CurrentPage / @Model.TotalPages</span>
                @if (Model.CurrentPage < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" class="btn btn-outline-secondary">Sau</a> }
            </nav>
        }
    }
</div>
