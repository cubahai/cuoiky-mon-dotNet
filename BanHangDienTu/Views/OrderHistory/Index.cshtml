@model List<BanHangDienTu.Models.OrderHistoryViewModel>
@using BanHangDienTu.Models.Constants
@{
    ViewData["Title"] = "Đơn mua của tôi";
    var currentStatus = (string)(ViewBag.CurrentStatus ?? "Tất cả");
    var statuses = new[] { "Tất cả", OrderStatus.Pending, OrderStatus.Shipping, OrderStatus.Completed, OrderStatus.Cancelled };
}

<div class="container mt-4 mb-5">
    <div class="mb-3">
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Quay lại Hồ sơ cá nhân
        </a>
    </div>

    <h2 class="mb-4">Lịch sử đơn mua</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh Tabs trạng thái phong cách Shopee -->
    <ul class="nav nav-tabs mb-4">
        @foreach (var tabStatus in statuses)
        {
            var isActive = (currentStatus == tabStatus);
            <li class="nav-item">
                <a class="nav-link @(isActive ? "active fw-bold text-danger border-bottom-0" : "text-secondary")"
                   asp-action="Index"
                   asp-route-status="@(tabStatus == "Tất cả" ? null : tabStatus)">
                    @tabStatus
                </a>
            </li>
        }
    </ul>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa có đơn hàng nào @(currentStatus != "Tất cả" ? $"ở trạng thái '{currentStatus}'" : ""). <a asp-controller="Home" asp-action="Index">Mua sắm ngay!</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <span class="fw-bold me-2">Mã đơn: #@order.OrderId</span>
                        <span class="text-muted small">| Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        <span class="text-muted small ms-2">| PTTT: @order.PaymentMethod</span>
                    </div>
                    <div>
                        <span class="badge @order.StatusBadgeClass px-3 py-2">@order.Status</span>
                    </div>
                </div>

                <div class="card-body">
                    @foreach (var item in order.Items)
                    {
                        <div class="d-flex align-items-center border-bottom pb-3 mb-3">
                            <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/default-product.svg" : item.ImageUrl)" alt="@item.ProductName" class="img-thumbnail me-3" style="width: 70px; height: 70px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/default-product.svg';" />
                            <div class="flex-grow-1">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">
                                    <h6 class="mb-1">@item.ProductName</h6>
                                </a>
                                <span class="text-muted small">Số lượng: x@(item.Quantity)</span>
                            </div>
                            <div class="text-end">
                                <span class="text-danger fw-semibold">@item.Price.ToString("N0") đ</span>
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-wrap justify-content-between align-items-center pt-2 gap-3">
                        <div>
                            <span class="text-muted">Tổng số tiền:</span>
                            <span class="fs-5 text-danger fw-bold ms-2">@order.TotalAmount.ToString("N0") đ</span>
                            @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                            {
                                <div class="text-muted small mt-1">
                                    Giao tới: <strong>@order.CustomerName</strong> - @order.PhoneNumber (@order.ShippingAddress)
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            @if (order.Status == OrderStatus.Pending)
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này? Số lượng sản phẩm sẽ được hoàn trả lại vào kho.');">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đơn hàng</button>
                                </form>
                            }
                            <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-secondary">Mua sắm thêm</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>