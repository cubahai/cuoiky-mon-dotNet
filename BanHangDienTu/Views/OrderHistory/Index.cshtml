@model List<BanHangDienTu.Models.OrderViewModel>
@{
    ViewData["Title"] = "Đơn mua của tôi";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Quay lại Hồ sơ cá nhân
        </a>
    </div>

    <h2 class="mb-4">Lịch sử đơn mua</h2>

    <!-- Thanh Tabs trạng thái phong cách Shopee -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link active fw-semibold" href="#">Tất cả (@(Model?.Count ?? 0))</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-secondary" href="#">Chờ xác nhận</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-secondary" href="#">Đang vận chuyển</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-secondary" href="#">Hoàn thành</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-secondary" href="#">Đã hủy</a>
        </li>
    </ul>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa có đơn hàng nào. <a asp-controller="Home" asp-action="Index">Mua sắm ngay!</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <span class="fw-bold me-2">Mã đơn: @order.OrderId</span>
                        <span class="text-muted small">| Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div>
                        <span class="badge @order.StatusBadgeClass px-3 py-2">@order.Status</span>
                    </div>
                </div>

                <div class="card-body">
                    @foreach (var item in order.Items)
                    {
                        <div class="d-flex align-items-center border-bottom pb-3 mb-3">
                            <img src="@item.ImageUrl" alt="@item.ProductName" class="img-thumbnail me-3" style="width: 70px; height: 70px; object-fit: cover;" />
                            <div class="flex-grow-1">
                                <h6 class="mb-1">@item.ProductName</h6>
                                <span class="text-muted small">Số lượng: x@item.Quantity</span>
                            </div>
                            <div class="text-end">
                                <span class="text-danger fw-semibold">@item.UnitPrice.ToString("N0") đ</span>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <div>
                            <span class="text-muted">Tổng số tiền:</span>
                            <span class="fs-5 text-danger fw-bold ms-2">@order.TotalAmount.ToString("N0") đ</span>
                        </div>
                        <div>
                            @if (order.Status == "Chờ xác nhận")
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger me-2">Hủy đơn hàng</button>
                            }
                            else if (order.Status == "Giao hàng thành công")
                            {
                                <button type="button" class="btn btn-sm btn-danger me-2">Mua lại</button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-secondary">Chi tiết đơn</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
