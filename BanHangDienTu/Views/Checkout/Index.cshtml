@model BanHangDienTu.ViewModels.Checkout.CheckoutViewModel
@{ ViewData["Title"] = "Xác nhận đặt hàng"; }

<div class="py-4">
    <a asp-controller="Cart" asp-action="Index">← Quay lại giỏ hàng</a>
    <h1 class="h2 my-4">Xác nhận đặt hàng</h1>
    <form asp-action="Index" method="post" id="checkoutForm">
        <input asp-for="CheckoutToken" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card h-100"><div class="card-body">
                    <h2 class="h5 mb-3">Thông tin nhận hàng</h2>
                    <div class="mb-3">
                        <label asp-for="RecipientName" class="form-label"></label>
                        <input asp-for="RecipientName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="RecipientName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3" autocomplete="street-address"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Note" class="form-label"></label>
                        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>
                    <p class="small text-muted">Thông tin nhận hàng này chỉ áp dụng cho đơn hiện tại.</p>
                    <h2 class="h5 mt-4">Thanh toán</h2>
                    <div class="border rounded p-3">
                        <strong>Thanh toán khi nhận hàng (COD)</strong>
                        <p class="mb-0 mt-1 text-muted">Bạn trả tiền cho người giao hàng khi nhận được sản phẩm.</p>
                    </div>
                </div></div>
            </div>
            <div class="col-lg-6">
                <div class="card"><div class="card-body">
                    <h2 class="h5 mb-3">Sản phẩm trong đơn</h2>
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="border-bottom py-3">
                            <div class="fw-semibold">@item.ProductName</div>
                            <div class="d-flex justify-content-between"><span>@item.Quantity × @item.Price.ToString("N0") ₫</span><strong>@item.TotalPrice.ToString("N0") ₫</strong></div>
                            @if (!item.CanOrder) { <div class="text-danger">Sản phẩm không còn bán hoặc không đủ tồn kho. Vui lòng sửa giỏ hàng.</div> }
                        </div>
                    }
                    <p class="mt-3">Phí vận chuyển: <span class="text-success">Miễn phí</span></p>
                    <p class="fs-5">Tổng thanh toán: <strong class="text-danger">@Model.Cart.TotalAmount.ToString("N0") ₫</strong></p>
                    @if (Model.Cart.CanCheckout)
                    { <button type="submit" class="btn btn-primary btn-lg w-100">Xác nhận đặt hàng COD</button> }
                    else
                    { <div class="alert alert-warning">Giỏ hàng chưa đủ điều kiện đặt hàng. <a asp-controller="Cart" asp-action="Index">Cập nhật giỏ hàng</a></div> }
                </div></div>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
