@model BanHangDienTu.Areas.Admin.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Thêm Tài Khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Thêm Tài Khoản Mới</h1>
    </div>
    <a href="@Url.Action("Index", "User")" class="btn btn-ghost">Quay lại</a>
</div>

<div class="card-panel" style="padding: 32px; max-width: 600px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 16px;"></div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; color: var(--text-2);">Email (Dùng làm tài khoản đăng nhập) *</label>
            <input asp-for="Email" style="width: 100%; padding: 12px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px;" />
            <span asp-validation-for="Email" style="color: #ef4444; font-size: 12px;"></span>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; color: var(--text-2);">Mật khẩu *</label>
            <input asp-for="Password" type="password" style="width: 100%; padding: 12px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px;" />
            <span asp-validation-for="Password" style="color: #ef4444; font-size: 12px;"></span>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; color: var(--text-2);">Họ và tên *</label>
            <input asp-for="FullName" style="width: 100%; padding: 12px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px;" />
            <span asp-validation-for="FullName" style="color: #ef4444; font-size: 12px;"></span>
        </div>

        <div style="margin-bottom: 32px;">
            <label style="display: block; margin-bottom: 8px; color: var(--text-2);">Số điện thoại</label>
            <input asp-for="PhoneNumber" style="width: 100%; padding: 12px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px;" />
        </div>

        <button type="submit" class="btn btn-primary">Tạo Tài Khoản</button>
    </form>
</div>