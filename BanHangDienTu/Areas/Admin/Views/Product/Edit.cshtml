@model BanHangDienTu.Areas.Admin.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Sửa Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Cập nhật Sản Phẩm</h1>
        <p class="page-sub">Chỉnh sửa thông tin, giá bán và tồn kho cho sản phẩm #@Model.Id.</p>
    </div>
    <a href="@Url.Action("Index", "Product")" class="btn btn-ghost"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
</div>

<div class="card-panel" style="padding: 32px; max-width: 800px;">
    <form asp-action="Edit" method="post">
        <!-- Rất quan trọng: Phải giữ ID để hệ thống biết đang sửa sản phẩm nào -->
        <input type="hidden" asp-for="Id" />

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 8px;">Tên sản phẩm *</label>
            <input asp-for="Name" style="width: 100%; padding: 12px 16px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px; outline: none;" />
            <span asp-validation-for="Name" style="color: #ef4444; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 8px;">Giá tiền (VNĐ) *</label>
                <input asp-for="Price" type="number" style="width: 100%; padding: 12px 16px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px; outline: none;" />
                <span asp-validation-for="Price" style="color: #ef4444; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
            <div>
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 8px;">Số lượng tồn kho *</label>
                <input asp-for="StockQuantity" type="number" style="width: 100%; padding: 12px 16px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px; outline: none;" />
                <span asp-validation-for="StockQuantity" style="color: #ef4444; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 8px;">Đường dẫn ảnh (URL)</label>
            <input asp-for="ImageUrl" style="width: 100%; padding: 12px 16px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px; outline: none;" />
        </div>

        <div style="margin-bottom: 32px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 8px;">Ghi chú / Mô tả</label>
            <textarea asp-for="Note" rows="4" style="width: 100%; padding: 12px 16px; background: var(--bg-1); border: 1px solid var(--border-md); color: var(--text-1); border-radius: 8px; outline: none; resize: vertical;"></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="padding: 12px 32px; font-size: 14px;"><i class="fa-solid fa-floppy-disk"></i> Lưu Thay Đổi</button>
    </form>
</div>