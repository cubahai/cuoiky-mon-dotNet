@model BanHangDienTu.Areas.Admin.ViewModels.DashBoardViewModel

@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tổng quan hệ thống</h1>
        <p class="page-sub">Xem thống kê kinh doanh và hoạt động của cửa hàng.</p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon stat-teal"><i class="fa-solid fa-boxes-stacked"></i></div>
        <div class="stat-value">@Model.TotalProducts</div>
        <div class="stat-label">Tổng sản phẩm tồn kho</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-orange"><i class="fa-solid fa-truck-fast"></i></div>
        <div class="stat-value">@Model.PendingOrders</div>
        <div class="stat-label">Đơn hàng chờ xử lý</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-purple"><i class="fa-solid fa-wallet"></i></div>
        <div class="stat-value">@Model.MonthlyRevenue.ToString("N0") ₫</div>
        <div class="stat-label">Doanh thu tháng này</div>
    </div>
    <div class="stat-card" style="border-color: rgba(239, 68, 68, 0.3); background: rgba(239, 68, 68, 0.02);">
        <div class="stat-icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="stat-value" style="color: #f87171;">@Model.LowStockCount</div>
        <div class="stat-label">Sản phẩm sắp hết hàng</div>
    </div>
</div>